DATABASE_HOST=aws.connect.psdb.cloud
DATABASE_USERNAME=your_planetscale_username
DATABASE_PASSWORD=your_planetscale_password

EMAIL_ENABLED=TRUE
# Zoho SMTP login. Visible From addresses live in lib/mailFrom.ts.
SENDER_EMAIL=info@kervinapps.com
SENDER_PASSWORD=your_zoho_app_password
SMTP_SERVER=smtp.zohocloud.ca
SMTP_PORT=465
NEXT_PUBLIC_APP_URL=https://workitapp.fit
APP_URL=https://workitapp.fit
WORKIT_SCOREBOARD_TO=leacock.kervin@gmail.com
CRON_SECRET=generate-a-long-random-string
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Portfolio telemetry (production Netlify). Client tracker is production-only.
APP_NAME=workit

# Web push workout reminders (docs/plans/PLAN_PUSH_REMINDERS.md). Generate once with
# `npx web-push generate-vapid-keys`; the private key is a secret. Subject is the app URL
# so no personal email goes to the push services.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://workitapp.fit
